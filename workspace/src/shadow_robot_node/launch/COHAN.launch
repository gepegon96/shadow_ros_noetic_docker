<launch>

  <param name="robot_description" textfile="$(find shadow_robot_node)/urdf/shadow.urdf" />
  
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

  <node name="svd48v_base_controller" pkg="shadow_robot_node" type="svd48v_base_controller.py" output="screen">
    <param name="port" value="/dev/Driver_base" />
    <param name="base_type" value="differential" />
    <param name="compute_period_ms" value="100" />
    <param name="pole_pairs" value="15" />
    <param name="id_driver1" value="2" />
    <param name="wheel_radius" value="100" />
    <param name="axes_length" value="518.0" />
    <param name="max_lin_speed" value="1000" />
    <param name="max_rot_speed" value="2" />
    <param name="max_current" value="20" />
    <param name="max_acceleration" value="500" />
    <param name="max_deceleration" value="1000" />
  </node>

<group ns="lidar_helios">
  <node pkg="rslidar_sdk" type="rslidar_sdk_node" name="rslidar_sdk_node">
    <param name="config_path" value="$(find shadow_robot_node)/config/lidar/config_helios.yaml" />
  </node>

  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan">
    <remap from="cloud_in" to="/rslidar_helios_points" />
  <remap from="scan" to="/scan_helios" />
  <param name="target_frame" value="helios" />
  <param name="min_height" value="-0.3" />
  <param name="max_height" value="0.3" />
  <param name="angle_min" value="-3.14159" />
  <param name="angle_max" value="3.14159" />
  <param name="range_min" value="0.4" /> 
  <param name="range_max" value="50.0" />

  </node>
</group>

<group ns="lidar_bpearl">
  <node pkg="rslidar_sdk" type="rslidar_sdk_node" name="rslidar_sdk_node">
    <param name="config_path" value="$(find shadow_robot_node)/config/lidar/config_bpearl.yaml" />
  </node>
  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan">
    <remap from="cloud_in" to="/rslidar_bpearl_points" />
    <remap from="scan" to="/scan_bpearl" />
    <param name="target_frame" value="bpearl" />
    <param name="min_height" value="-0.1" />
    <param name="max_height" value="0.5" />
    <param name="angle_min" value="-1.8" />
    <param name="angle_max" value="1.8" />
    <param name="range_min" value="0.5" /> 
    <param name="range_max" value="30.0" />
  </node>
</group>

  <node name="map_server" pkg="map_server" type="map_server" args="$(find shadow_robot_node)/maps/informatica.yaml" />

<include file="$(find shadow_robot_node)/config/amcl/amcl_node.xml" />

  <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_footprint" args="0 0 0 0 0 0 base_link base_footprint" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="helios_to_lidar_data" args="0 0 0 0 0 0 helios rslidar_helios_points" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="odom_tf_parche" args="0 0 0 0 0 0 odom odom_combined" />

  <!-- <node pkg="topic_tools" type="relay" name="odom_topic_parche" args="/odom /odom_combined" /> -->

<!-- <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
  
  <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
  
  <rosparam file="$(find shadow_robot_node)/config/move_base/costmap_common_params.yaml" command="load" ns="global_costmap" />
  <rosparam file="$(find shadow_robot_node)/config/move_base/costmap_common_params.yaml" command="load" ns="local_costmap" />
  <rosparam file="$(find shadow_robot_node)/config/move_base/local_costmap_params.yaml" command="load" />
  <rosparam file="$(find shadow_robot_node)/config/move_base/global_costmap_params.yaml" command="load" />
  <rosparam file="$(find shadow_robot_node)/config/move_base/teb_local_planner_params.yaml" command="load" />

</node> -->

<include file="$(find cohan_navigation)/launch/shadow_launch/shadow_nav.launch"> </include>

<include file="$(find zed_wrapper)/launch/zed2i.launch">
    
    <arg name="base_frame" value="zed_camera_link" />

    <arg name="cam_pos_x" value="0.0" />
    <arg name="cam_pos_y" value="-0.06" /> 
    <arg name="cam_pos_z" value="0.0" />
    
    <arg name="cam_roll"  value="0.0" />
    <arg name="cam_pitch" value="0.0" />
    <arg name="cam_yaw"   value="0.0" />
  </include>

<include file="$(find visual_perception_tracking)/launch/visual_perception.launch"> </include>

  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find shadow_robot_node)/config/rviz/cohan_rviz.rviz" />

</launch>
